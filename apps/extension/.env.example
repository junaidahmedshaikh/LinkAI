# LinkAI Extension — environment variables
# Copy to .env before building: cp .env.example .env

# Production API base URL (no trailing slash)
VITE_API_URL=https://api.yourdomain.com

# Production web app URL (no trailing slash)
VITE_WEB_URL=https://app.yourdomain.com

# Set in web app .env after loading unpacked extension (chrome://extensions)
VITE_EXTENSION_ID=

# Optional legal page URLs (default: {VITE_WEB_URL}/privacy and /terms)
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Production build uses NODE_ENV=production to omit localhost host permissions.
# Development: npm run dev (localhost origins included automatically)
