PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/linkai
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=linkai-dev-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=linkai-dev-refresh-secret-min-32-chars!

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback

EMAIL_FROM=noreply@linkai.app

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5

# Optional — without key, dev mock comments are used
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
